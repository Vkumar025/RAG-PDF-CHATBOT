# Groq API Key (get free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Name on Groq (e.g. llama-3.3-70b-versatile, llama3-8b-8192, openai/gpt-oss-120b)
OLLAMA_MODEL=llama-3.3-70b-versatile

# MongoDB Connection (Local or Atlas URI)
MONGO_URL=mongodb://localhost:27017
DATABASE_NAME=rag_pdf_chatbot

# JWT Authentication Config
SECRET_KEY=rag_pdf_chatbot_secret_key_change_in_production_123456
ALGORITHM=HS256
